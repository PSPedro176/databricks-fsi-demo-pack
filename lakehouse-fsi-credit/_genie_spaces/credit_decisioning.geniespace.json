{
  "version": 2,
  "config": {
    "sample_questions": [
      {
        "id": "q1_high_risk",
        "question": [
          "Which customers have the highest credit risk based on their prediction scores?"
        ]
      },
      {
        "id": "q2_overdue",
        "question": [
          "Show me the total credit overdue amounts by customer"
        ]
      },
      {
        "id": "q3_features",
        "question": [
          "What are the average tenure and revenue for customers grouped by education level?"
        ]
      },
      {
        "id": "q4_transactions",
        "question": [
          "Which customers have the highest transaction volume in the last 12 months?"
        ]
      }
    ]
  },
  "data_sources": {
    "tables": [
      {
        "identifier": "${var.catalog}.fsi_credit.customer_gold",
        "column_configs": [
          {
            "column_name": "id"
          },
          {
            "column_name": "first_name"
          },
          {
            "column_name": "last_name"
          },
          {
            "column_name": "email"
          },
          {
            "column_name": "gender"
          },
          {
            "column_name": "city"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_credit.credit_bureau_gold",
        "column_configs": [
          {
            "column_name": "CUST_ID"
          },
          {
            "column_name": "AMT_CREDIT_SUM"
          },
          {
            "column_name": "AMT_CREDIT_SUM_DEBT"
          },
          {
            "column_name": "AMT_CREDIT_SUM_OVERDUE"
          },
          {
            "column_name": "AMT_CREDIT_MAX_OVERDUE"
          },
          {
            "column_name": "CREDIT_ACTIVE"
          },
          {
            "column_name": "CREDIT_DAY_OVERDUE"
          },
          {
            "column_name": "CNT_CREDIT_PROLONG"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_credit.fund_trans_gold",
        "column_configs": [
          {
            "column_name": "cust_id"
          },
          {
            "column_name": "sent_txn_cnt_12m"
          },
          {
            "column_name": "sent_txn_amt_12m"
          },
          {
            "column_name": "rcvd_txn_cnt_12m"
          },
          {
            "column_name": "rcvd_txn_amt_12m"
          },
          {
            "column_name": "dist_payer_cnt_12m"
          },
          {
            "column_name": "dist_payee_cnt_12m"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_credit.telco_gold",
        "column_configs": [
          {
            "column_name": "cust_id"
          },
          {
            "column_name": "avg_phone_bill_amt_lst12mo"
          },
          {
            "column_name": "number_payment_delays_last12mo"
          },
          {
            "column_name": "phone_bill_amt"
          },
          {
            "column_name": "is_pre_paid"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_credit.credit_decisioning_features",
        "column_configs": [
          {
            "column_name": "cust_id"
          },
          {
            "column_name": "education"
          },
          {
            "column_name": "marital_status"
          },
          {
            "column_name": "months_employment"
          },
          {
            "column_name": "tenure_months"
          },
          {
            "column_name": "product_cnt"
          },
          {
            "column_name": "tot_rel_bal"
          },
          {
            "column_name": "revenue_tot"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_credit.underbanked_prediction",
        "column_configs": [
          {
            "column_name": "cust_id"
          },
          {
            "column_name": "education"
          },
          {
            "column_name": "tenure_months"
          },
          {
            "column_name": "tot_rel_bal"
          },
          {
            "column_name": "revenue_tot"
          },
          {
            "column_name": "prediction"
          }
        ]
      }
    ]
  },
  "instructions": {
    "text_instructions": [
      {
        "id": "instr_context",
        "content": "This Genie space helps analysts explore credit decisioning data. It covers customer profiles, credit bureau history, fund transactions, telco data, engineered features, and model predictions for underbanked customer identification."
      },
      {
        "id": "instr_joins",
        "content": "Join tables on customer ID: customer_gold.id = credit_bureau_gold.CUST_ID = fund_trans_gold.cust_id = telco_gold.cust_id = credit_decisioning_features.cust_id = underbanked_prediction.cust_id"
      },
      {
        "id": "instr_prediction",
        "content": "The underbanked_prediction table contains the model output. The 'prediction' column indicates whether the customer is predicted to be underbanked (1) or not (0). Use credit_decisioning_features for the input features used by the model."
      }
    ]
  }
}