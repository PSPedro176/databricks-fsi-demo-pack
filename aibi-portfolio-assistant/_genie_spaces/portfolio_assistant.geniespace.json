{
  "version": 2,
  "config": {
    "sample_questions": [
      {
        "id": "q1_portfolio_top",
        "question": [
          "What are the top 5 companies in my portfolio by market capitalization?"
        ]
      },
      {
        "id": "q2_volatility",
        "question": [
          "Show me market volatility during the 2008 financial crisis"
        ]
      },
      {
        "id": "q3_sentiment",
        "question": [
          "What is the sentiment distribution for technology stocks?"
        ]
      },
      {
        "id": "q4_negative_news",
        "question": [
          "What are the latest negative news events impacting my portfolio?"
        ]
      }
    ]
  },
  "data_sources": {
    "tables": [
      {
        "identifier": "${var.catalog}.fsi_portfolio_assistant.portfolio",
        "column_configs": [
          {
            "column_name": "ticker"
          },
          {
            "column_name": "company_name"
          },
          {
            "column_name": "industry"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_portfolio_assistant.fundamentals",
        "column_configs": [
          {
            "column_name": "ticker"
          },
          {
            "column_name": "market_capitalization"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_portfolio_assistant.prices",
        "column_configs": [
          {
            "column_name": "ticker"
          },
          {
            "column_name": "date"
          },
          {
            "column_name": "close"
          },
          {
            "column_name": "return"
          },
          {
            "column_name": "split_factor"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_portfolio_assistant.news",
        "column_configs": [
          {
            "column_name": "article_id"
          },
          {
            "column_name": "title"
          },
          {
            "column_name": "published_time"
          },
          {
            "column_name": "sentiment"
          },
          {
            "column_name": "market_sentiment"
          },
          {
            "column_name": "source"
          },
          {
            "column_name": "source_url"
          }
        ]
      },
      {
        "identifier": "${var.catalog}.fsi_portfolio_assistant.news_ticker",
        "column_configs": [
          {
            "column_name": "article_id"
          },
          {
            "column_name": "ticker"
          }
        ]
      }
    ]
  },
  "instructions": {
    "text_instructions": [
      {
        "id": "instr_context",
        "content": "This Genie space helps portfolio managers analyze their investment portfolio performance and market trends. The data covers stock prices, company fundamentals, and financial news with sentiment analysis."
      },
      {
        "id": "instr_joins",
        "content": "Join portfolio to prices on ticker. Join portfolio to fundamentals on ticker. Join news to news_ticker on article_id. Join news_ticker to portfolio on ticker."
      }
    ]
  }
}